---
const equipo = [
  {
    nombre: "Diego Antonio Sotomayor Stagno",
    cargo: "Abogado & Cientista Político",
    titulos: [
      "Abogado — Universidad Finis Terrae",
      "Cientista Político — Universidad Gabriela Mistral"
    ]
  },
  {
    nombre: "Mikel Xavier Basauri Fernández",
    cargo: "Abogado",
    titulos: [
      "Licenciado en Ciencias Jurídicas — Universidad Finis Terrae"
    ]
  }
];
---

<section id="equipo" class="bg-black text-white py-24 md:py-36 px-6 md:px-12 selection:bg-white selection:text-black">
  <div class="max-w-7xl mx-auto flex flex-col gap-16">
    
    <!-- Encabezado Minimalista Tipo "MINDS" -->
    <div class="flex items-center justify-between border-b border-zinc-800 pb-6">
      <h2 class="font-montserrat text-2xl md:text-3xl font-black uppercase tracking-wider text-white">
        NUESTRO EQUIPO
      </h2>
      <span class="text-xs font-mono uppercase tracking-widest text-zinc-400">
        [ 04 / PROFESIONALES ]
      </span>
    </div>

    <!-- Grid de Retratos Verticales Gigantes (Placeholders Estilo Referencia MINDS) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {equipo.map((miembro) => (
        <div class="flex flex-col gap-6 group">
          
          <!-- Retrato Vertical Grande Grayscale que ocupa la mayor parte del espacio -->
          <div class="w-full aspect-[3/4] bg-zinc-900 border border-zinc-800 rounded-lg relative overflow-hidden grayscale group-hover:border-zinc-500 transition-all duration-500 shadow-2xl flex items-center justify-center">
            
            <!-- Degradado sutil de contraste -->
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10 opacity-75"></div>
            
            <!-- Placeholder Silhouette Icon & Text -->
            <div class="flex flex-col items-center gap-4 text-zinc-600 group-hover:text-zinc-400 transition-colors z-20 p-6 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-28 w-28 stroke-[0.8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="text-xs font-mono uppercase tracking-widest text-zinc-400">[ RETRATO PROFESIONAL ]</span>
            </div>

            <!-- Cargo flotante en la esquina inferior izquierda -->
            <div class="absolute bottom-6 left-6 z-20">
              <span class="text-xs font-mono uppercase tracking-widest bg-white text-black font-bold px-3 py-1">
                {miembro.cargo}
              </span>
            </div>
          </div>

          <!-- Información del Profesional debajo de la Foto -->
          <div class="space-y-2">
            <h3 class="font-montserrat text-2xl md:text-3xl font-extrabold uppercase tracking-tight text-white group-hover:translate-x-1 transition-transform">
              {miembro.nombre}
            </h3>
            
            <div class="space-y-1">
              {miembro.titulos.map((titulo) => (
                <p class="text-xs sm:text-sm font-sans text-zinc-400 font-medium">
                  {titulo}
                </p>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Frase Editorial Gigante Estilo MINDS de la Referencia -->
    <div class="pt-16 border-t border-zinc-900">
      <p class="font-montserrat text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight leading-tight text-white opacity-90">
        Minds. Talent. Knowledge. Sharing. Integrity. Experience. Potential. Strength. Wisdom. Vision. Future. Ideas.
      </p>
    </div>

  </div>
</section>
