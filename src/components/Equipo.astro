---
const equipo = [
  {
    nombre: "Diego Antonio Sotomayor Stagno",
    cargo: "Abogado & Cientista Político",
    titulos: [
      "Abogado — Universidad Finis Terrae",
      "Cientista Político — Universidad Gabriela Mistral",
    ],
  },
  {
    nombre: "Mikel Xavier Basauri Fernández",
    cargo: "Abogado",
    titulos: ["Licenciado en Ciencias Jurídicas — Universidad Finis Terrae"],
  },
];
---

<section
  id="equipo"
  class="bg-black text-white py-24 md:py-36 px-6 md:px-12 selection:bg-white selection:text-black"
>
  <div class="max-w-7xl mx-auto flex flex-col gap-16">
    <!-- Encabezado Minimalista Tipo "MINDS" -->
    <div
      class="flex items-center justify-between border-b border-zinc-800 pb-6"
    >
      <h2
        class="font-montserrat text-2xl md:text-3xl font-black uppercase tracking-wider text-white"
      >
        NUESTRO EQUIPO
      </h2>
      <span class="text-xs font-mono uppercase tracking-widest text-zinc-400">
        [ PROFESIONALES ]
      </span>
    </div>

    <!-- Grid de Información de Profesionales (Lista Tipográfica Minimalista) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
      {
        equipo.map((miembro) => (
          <div class="flex flex-col border-t border-zinc-800 pt-8 space-y-4">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 font-bold block">
                [ {miembro.cargo} ]
              </span>
              <h3 class="font-montserrat text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-white leading-tight">
                {miembro.nombre}
              </h3>
            </div>

            <div class="space-y-1.5 pt-2">
              {miembro.titulos.map((titulo) => (
                <p class="text-sm sm:text-base font-sans text-zinc-400 font-medium leading-relaxed">
                  {titulo}
                </p>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Frase Editorial Gigante Estilo MINDS de la Referencia -->
    <div class="pt-16 border-t border-zinc-900">
      <p
        class="font-montserrat text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight leading-tight text-white opacity-90"
      >
        Como abogados brindamos una asesoría legal integral y una gestión
        eficiente para cada área de trabajo destinada a resolver litigios
        complejos y proteger en todo momento los intereses de nuestros clientes.
      </p>
    </div>
  </div>
</section>
