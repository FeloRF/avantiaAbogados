---
import { Image } from "astro:assets";
import abo1 from "../assests/img/abo1.jpeg";
import abo2 from "../assests/img/abo2.jpeg";
---

<section
  id="mision"
  class="bg-black text-white py-24 md:py-36 px-6 md:px-12 selection:bg-white selection:text-black"
>
  <div class="max-w-7xl mx-auto">
    <!-- Declaración de la Misión -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Columna Derecha: Bloque de Texto Principal Horizontal (80%+ del ancho) -->
      <div class="lg:col-span-10">
        <h2
          class="font-montserrat text-4xl sm:text-5xl md:text-5xl font-black uppercase tracking-tight leading-snug text-white text-justify"
        >
          NUESTRA MISIÓN ES BRINDAR ASESORÍA Y REPRESENTACIÓN JURÍDICA, CERCANA,
          RESPONSABLE Y COMPROMETIDA CON LAS NECESIDADES DE CADA PERSONA Y
          ORGANIZACIÓN QUE CONFÍA EN NOSOTROS.
        </h2>
      </div>
    </div>

    <!-- Contenedor Principal de Imágenes: Layout Editorial Asimétrico -->
    <div
      class="pt-24 grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start"
    >
      <!-- Imagen 1 (Pequeña - Izquierda: 4 columnas) -->
      <div class="md:col-span-4">
        <Image
          src={abo1}
          alt="Abogado de Avantia Abogados"
          class="w-full h-full object-cover aspect-[3/4] grayscale"
        />
      </div>

      <!-- Imagen 2 (Protagonista - Derecha: 8 columnas) -->
      <div class="md:col-span-8">
        <Image
          src={abo2}
          alt="Equipo de Avantia Abogados"
          class="w-full h-auto object-cover grayscale"
        />
      </div>
    </div>
  </div>
</section>
