---

---

<section
  id="contacto"
  class="bg-white text-black py-24 md:py-36 px-6 md:px-12 selection:bg-black selection:text-white"
>
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start"
  >
    <!-- Información de Contacto -->
    <div class="lg:col-span-5 space-y-8">
      <div>
        <span
          class="text-xs font-mono uppercase tracking-widest text-zinc-500 block mb-2"
          >[ 05 / CONTACTO ]</span
        >
        <h2
          class="font-montserrat text-4xl md:text-6xl font-black uppercase tracking-tight text-black"
        >
          AGENDE SU CONSULTA
        </h2>
      </div>

      <p class="text-base text-zinc-700 font-sans leading-relaxed">
        Póngase en contacto con nuestro equipo legal para evaluar su caso en
        detalle y definir la mejor estrategia jurídica.
      </p>

      <div class="space-y-6 pt-4 border-t-2 border-black font-mono text-sm">
        <div>
          <span class="block text-xs uppercase text-zinc-500 mb-1"
            >Sitio Web Oficial</span
          >
          <span class="font-bold text-lg text-black">AVANTIA ABOGADOS.CL</span>
        </div>
        <div>
          <span class="block text-xs uppercase text-zinc-500 mb-1"
            >Ubicación</span
          >
          <span class="font-bold text-black"
            >Santiago, Región Metropolitana, Chile</span
          >
        </div>
        <div>
          <span class="block text-xs uppercase text-zinc-500 mb-1"
            >Horario de Atención</span
          >
          <span class="font-bold text-black"
            >Lunes a Viernes: 09:00 - 18:30 hrs</span
          >
        </div>
      </div>
    </div>

    <!-- Formulario Minimalista en Tarjeta Negra -->
    <div
      class="lg:col-span-7 bg-black text-white p-8 md:p-12 rounded-3xl shadow-2xl"
    >
      <h3
        class="font-montserrat text-2xl font-bold uppercase tracking-wide mb-6"
      >
        Formulario de Contacto Directo
      </h3>

      <form
        class="space-y-6"
        onsubmit="event.preventDefault(); alert('Mensaje listo para envío.');"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label
              class="block text-xs font-mono uppercase tracking-widest text-zinc-400"
              >Nombre Completo</label
            >
            <input
              type="text"
              required
              placeholder="Ej. Juan Pérez"
              class="w-full bg-zinc-900 border border-zinc-700 text-white px-4 py-3 text-sm rounded-lg focus:border-white focus:outline-none transition-colors"
            />
          </div>
          <div class="space-y-2">
            <label
              class="block text-xs font-mono uppercase tracking-widest text-zinc-400"
              >Correo Electrónico</label
            >
            <input
              type="email"
              required
              placeholder="ejemplo@correo.cl"
              class="w-full bg-zinc-900 border border-zinc-700 text-white px-4 py-3 text-sm rounded-lg focus:border-white focus:outline-none transition-colors"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label
            class="block text-xs font-mono uppercase tracking-widest text-zinc-400"
            >Área de Interés Legal</label
          >
          <select
            class="w-full bg-zinc-900 border border-zinc-700 text-white px-4 py-3 text-sm rounded-lg focus:border-white focus:outline-none transition-colors"
          >
            <option>Derecho Civil</option>
            <option>Derecho de Familia</option>
            <option>Derecho Administrativo</option>
            <option>Derecho Penal</option>
            <option>Derecho Laboral</option>
            <option>Juzgado de Policía Local</option>
            <option>Otra Consulta Legal</option>
          </select>
        </div>

        <div class="space-y-2">
          <label
            class="block text-xs font-mono uppercase tracking-widest text-zinc-400"
            >Detalle de su Consulta</label
          >
          <textarea
            rows="4"
            required
            placeholder="Describa brevemente la situación legal..."
            class="w-full bg-zinc-900 border border-zinc-700 text-white px-4 py-3 text-sm rounded-lg focus:border-white focus:outline-none transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-white text-black font-extrabold uppercase tracking-widest text-sm rounded-full hover:bg-zinc-200 transition-colors border border-white"
        >
          Enviar Mensaje Legal
        </button>
      </form>
    </div>
  </div>
</section>

<!-- Footer -->
<footer
  class="bg-black text-white border-t border-zinc-800 py-8 px-6 text-xs font-mono"
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4"
  >
    <div>© 2026 AVANTIA ABOGADOS.CL — Todos los derechos reservados.</div>
    <div class="flex gap-4 text-zinc-400">
      <span>Santiago, Chile</span>
      <span>•</span>
      <span>Diseño de Alto Contraste Monocromo</span>
    </div>
  </div>
</footer>
