---

---

<header
  class="bg-white text-black min-h-screen flex flex-col justify-between px-6 md:px-12 py-8 selection:bg-black selection:text-white"
>
  <!-- Navbar Top -->
  <div class="max-w-7xl mx-auto w-full flex items-center justify-between">
    <a
      href="#"
      class="font-montserrat font-black text-xl md:text-2xl tracking-tighter uppercase text-black"
    >
      AVANTIA ABOGADOS
    </a>
    <nav
      class="hidden md:flex items-center gap-8 text-xs font-bold tracking-widest uppercase text-zinc-700"
    >
      <a
        href="#mision"
        class="hover:text-black hover:underline underline-offset-4 transition-all"
        >Misión</a
      >
      <a
        href="#areas"
        class="hover:text-black hover:underline underline-offset-4 transition-all"
        >Áreas de Trabajo</a
      >
      <a
        href="#equipo"
        class="hover:text-black hover:underline underline-offset-4 transition-all"
        >Equipo</a
      >
      <a
        href="#contacto"
        class="hover:text-black hover:underline underline-offset-4 transition-all"
        >Contacto</a
      >
    </nav>
  </div>

  <!-- Hero Content: Centrado Absoluto -->
  <div
    class="max-w-4xl mx-auto w-full my-auto py-16 flex flex-col items-center justify-center text-center gap-8"
  >
    <!-- Título Solido Negro sin Outline -->
    <h1
      class="font-montserrat text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-black uppercase tracking-tighter leading-none text-black"
    >
      <span class="inline-block -mr-4.5">A</span>
      <span class="inline-block -mr-4.5">V</span>
      <span class="inline-block">A</span>NTIA<br />
      ABOGADOS
    </h1>

    <p
      class="max-w-xl text-base md:text-lg text-zinc-600 font-sans font-medium tracking-wide"
    >
      Asesoría y representación jurídica de excelencia, cercanía y rigurosidad.
    </p>

    <!-- Botón Minimalista Estilo Píldora (Pill) -->
    <div class="pt-4">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-8 py-4 bg-black text-white rounded-full font-bold text-sm tracking-wider uppercase hover:bg-zinc-800 hover:scale-105 active:scale-95 transition-all duration-300 shadow-xl"
      >
        <span>Agendar Consulta Legal</span>
      </a>
    </div>
  </div>

  <!-- Indicador Inferior Centrado -->
  <div
    class="max-w-7xl mx-auto w-full flex items-center justify-between text-xs font-mono uppercase tracking-widest text-zinc-400 pt-8 border-t border-zinc-100"
  >
    <span>[ 01 / INICIO ]</span>
    <span>SANTIAGO DE CHILE</span>
  </div>
</header>
