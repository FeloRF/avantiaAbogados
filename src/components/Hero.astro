---
import { Image } from "astro:assets";
import heroImg from "../assests/img/hall1.jpg";
---

<header
  class="bg-white text-black min-h-screen px-6 md:px-12 py-8 md:py-12 flex flex-col justify-between selection:bg-black selection:text-white"
>
  <div class="max-w-7xl mx-auto w-full my-auto">
    <!-- Header (Navegación) -->
    <div class="flex justify-between items-center w-full mb-12 md:mb-20">
      <!-- Logo Construido con Tailwind (Agrandado) -->
      <a href="#" class="flex items-center gap-4 z-50 relative cursor-pointer">
        <!-- Caja Negra del Isotipo -->
        <div
          class="bg-black text-white font-montserrat font-bold text-2xl md:text-3xl lg:text-4xl w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 flex items-center justify-center tracking-tighter shadow-sm"
        >
          AV
        </div>

        <!-- Tipografía del Nombre -->
        <div
          class="flex flex-col font-montserrat uppercase text-black"
        >
          <span class="font-extrabold text-xl md:text-2xl lg:text-3xl leading-none mb-1 tracking-widest"
            >AVANTIA</span
          >
          <span class="font-semibold text-xs md:text-sm lg:text-base leading-none tracking-[0.25em] text-zinc-600"
            >ABOGADOS</span
          >
        </div>
      </a>

      <!-- Menú Derecha -->
      <nav
        class="hidden md:flex gap-4 lg:gap-6 text-xs lg:text-sm font-semibold uppercase tracking-wider text-black"
      >
        <a href="#" class="hover:text-gray-600 transition-colors">INICIO</a>
        <a href="#mision" class="hover:text-gray-600 transition-colors"
          >NUESTRA MISIÓN</a
        >
        <a href="#areas" class="hover:text-gray-600 transition-colors"
          >ÁREAS DE PRÁCTICA</a
        >
        <a href="#equipo" class="hover:text-gray-600 transition-colors"
          >EQUIPO</a
        >
        <a href="#contacto" class="hover:text-gray-600 transition-colors"
          >CONTACTO</a
        >
      </nav>
    </div>

    <!-- Cuerpo del Hero (Grid 2 Columnas) -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mt-8 md:mt-12"
    >
      <!-- Columna Izquierda (Texto y Botón sin recuadro) -->
      <div class="flex flex-col justify-center">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold uppercase leading-[1.05] tracking-tighter mb-6 text-black text-balance"
        >
          ASESORÍA Y REPRESENTACIÓN JURÍDICA.
        </h1>
        <p
          class="text-base md:text-lg text-gray-700 leading-relaxed mb-8 md:mb-10 text-balance"
        >
          Cercanía y rigurosidad. Comprometidos con su éxito legal en cada caso.
        </p>
        <div>
          <a
            href="#contacto"
            class="inline-block bg-black text-white font-bold uppercase tracking-widest text-sm px-10 py-4 rounded-full hover:bg-gray-800 transition-colors shadow-lg"
          >
            AGENDAR CONSULTA LEGAL
          </a>
        </div>
      </div>

      <!-- Columna Derecha (Imagen Vertical) -->
      <div
        class="w-full aspect-square lg:aspect-[4/5] overflow-hidden rounded-2xl md:rounded-3xl shadow-2xl"
      >
        <Image
          src={heroImg}
          alt="Hall Avantia Abogados"
          class="w-full h-full object-cover grayscale"
        />
      </div>
    </div>
  </div>
</header>
